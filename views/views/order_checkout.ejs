<%- include('partials/header', { pageTitle: '배송지 입력' }) %>

<div class="container" style="max-width: 700px;">
    <h2>🚚 주문 - 1/3 단계</h2>

    <div style="display:flex; gap:6px; margin: 14px 0;">
        <div style="flex:1; padding:8px; background:#2563eb; color:white; text-align:center; border-radius:5px; font-size:12px;">① 배송지 입력</div>
        <div style="flex:1; padding:8px; background:#e5e7eb; color:#888; text-align:center; border-radius:5px; font-size:12px;">② 결제</div>
        <div style="flex:1; padding:8px; background:#e5e7eb; color:#888; text-align:center; border-radius:5px; font-size:12px;">③ 주문 완료</div>
    </div>

    <h3>🛍️ 주문 상품</h3>
    <table class="board-table" style="margin-bottom: 16px;">
        <thead>
            <tr>
                <th>상품</th>
                <th style="text-align:center;">수량</th>
                <th style="text-align:right;">소계</th>
            </tr>
        </thead>
        <tbody>
            <% items.forEach(item => { %>
                <tr>
                    <td><%= item.emoji %> <%= item.name %></td>
                    <td style="text-align:center;"><%= item.quantity %>개</td>
                    <td style="text-align:right;">₩<%= (item.price * item.quantity).toLocaleString() %></td>
                </tr>
            <% }) %>
            <tr style="background:#f9f9f9; font-weight:bold;">
                <td colspan="2" style="text-align:right;">총 결제 금액</td>
                <td style="text-align:right; color:#2563eb;">₩<%= total.toLocaleString() %></td>
            </tr>
        </tbody>
    </table>

    <h3>📍 배송지 정보</h3>
    <form action="order/payment" method="POST">
        <label for="receiver_name">받는 사람 <span style="color:red;">*</span></label>
        <input type="text" id="receiver_name" name="receiver_name" 
               value="<%= userInfo ? userInfo.name : '' %>" required>

        <label for="receiver_phone">연락처 <span style="color:red;">*</span></label>
        <input type="text" id="receiver_phone" name="receiver_phone" 
               value="<%= userInfo && userInfo.phone ? userInfo.phone : '' %>"
               placeholder="010-1234-5678" required>

        <label for="receiver_address">배송 주소 <span style="color:red;">*</span></label>
        <input type="text" id="receiver_address" name="receiver_address" 
               value="<%= userInfo && userInfo.address ? userInfo.address : '' %>" required>

        <label for="delivery_memo">배송 메모</label>
        <select id="delivery_memo" name="delivery_memo">
            <option value="">선택해 주세요</option>
            <option value="문 앞에 놓아주세요">문 앞에 놓아주세요</option>
            <option value="경비실에 맡겨주세요">경비실에 맡겨주세요</option>
            <option value="배송 전 연락 부탁드립니다">배송 전 연락 부탁드립니다</option>
        </select>

        <div style="display: flex; gap: 10px; margin-top: 16px;">
            <a href="cart" class="btn btn-secondary" style="flex:1; text-align:center;">← 장바구니로</a>
            <button type="submit" style="flex:1;">결제 단계로 →</button>
        </div>
    </form>
</div>

<%- include('partials/footer') %>
