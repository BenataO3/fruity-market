<%- include('partials/header', { pageTitle: '결제' }) %>

<div class="container" style="max-width: 700px;">
    <h2>💳 주문 - 2/3 단계</h2>

    <div style="display:flex; gap:6px; margin: 14px 0;">
        <div style="flex:1; padding:8px; background:#22c55e; color:white; text-align:center; border-radius:5px; font-size:12px;">✓ 배송지 입력</div>
        <div style="flex:1; padding:8px; background:#2563eb; color:white; text-align:center; border-radius:5px; font-size:12px;">② 결제</div>
        <div style="flex:1; padding:8px; background:#e5e7eb; color:#888; text-align:center; border-radius:5px; font-size:12px;">③ 주문 완료</div>
    </div>

    <h3>📍 배송지 확인</h3>
    <table class="board-table" style="margin-bottom: 16px;">
        <tr><th style="width:120px;">받는 사람</th><td><%= checkoutInfo.receiver_name %></td></tr>
        <tr><th>연락처</th><td><%= checkoutInfo.receiver_phone %></td></tr>
        <tr><th>주소</th><td><%= checkoutInfo.receiver_address %></td></tr>
        <% if (checkoutInfo.delivery_memo) { %>
            <tr><th>배송 메모</th><td><%= checkoutInfo.delivery_memo %></td></tr>
        <% } %>
    </table>

    <h3>🛍️ 주문 상품</h3>
    <table class="board-table" style="margin-bottom: 16px;">
        <thead>
            <tr><th>상품</th><th style="text-align:center;">수량</th><th style="text-align:right;">소계</th></tr>
        </thead>
        <tbody>
            <% items.forEach(item => { %>
                <tr>
                    <td><%= item.emoji %> <%= item.name %></td>
                    <td style="text-align:center;"><%= item.quantity %>개</td>
                    <td style="text-align:right;">₩<%= (item.price * item.quantity).toLocaleString() %></td>
                </tr>
            <% }) %>
            <tr style="background:#f9f9f9; font-weight:bold;">
                <td colspan="2" style="text-align:right;">총 결제 금액</td>
                <td style="text-align:right; color:#2563eb; font-size:16px;">₩<%= total.toLocaleString() %></td>
            </tr>
        </tbody>
    </table>

    <h3>💳 결제 수단 선택</h3>
    <form action="order/confirm" method="POST">
        <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap:8px; margin: 14px 0;">
            <label style="border:2px solid #eee; padding:12px; border-radius:6px; text-align:center; cursor:pointer; font-weight:normal;">
                <input type="radio" name="payment_method" value="신용카드" checked> 💳 신용카드
            </label>
            <label style="border:2px solid #eee; padding:12px; border-radius:6px; text-align:center; cursor:pointer; font-weight:normal;">
                <input type="radio" name="payment_method" value="계좌이체"> 🏦 계좌이체
            </label>
            <label style="border:2px solid #eee; padding:12px; border-radius:6px; text-align:center; cursor:pointer; font-weight:normal;">
                <input type="radio" name="payment_method" value="무통장입금"> 💵 무통장입금
            </label>
            <label style="border:2px solid #eee; padding:12px; border-radius:6px; text-align:center; cursor:pointer; font-weight:normal;">
                <input type="radio" name="payment_method" value="휴대폰결제"> 📱 휴대폰결제
            </label>
        </div>

        <div style="background:#fef3c7; padding: 12px; border-radius: 6px; border-left: 4px solid #f59e0b; margin: 14px 0;">
            <strong style="color:#92400e;">💳 결제 안내</strong>
            <p style="color:#78350f; font-size: 13px; margin: 6px 0 0;">
                본 시스템은 데모이므로 실제 결제는 진행되지 않습니다.
            </p>
        </div>

        <div style="display: flex; gap: 10px; margin-top: 16px;">
            <a href="javascript:history.back()" class="btn btn-secondary" style="flex:1; text-align:center;">← 이전</a>
            <button type="submit" class="btn btn-success" style="flex:1; padding:12px; font-size:15px;">
                ✅ 주문 확정 (₩<%= total.toLocaleString() %>)
            </button>
        </div>
    </form>
</div>

<%- include('partials/footer') %>
